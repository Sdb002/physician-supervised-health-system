# Copy to .env and fill in. The app runs without an API key: lab slips are
# read on this server (RapidOCR) and reports use the built-in template.

# Anthropic API key for report writing and, if chosen below, lab-slip reading (optional)
ANTHROPIC_API_KEY=

# Who reads an uploaded lab-slip photo: auto (RapidOCR on this server when
# installed, else Claude), local, or claude (sends the image to Anthropic)
OCR_ENGINE=auto

# Database. SQLite needs no setup. For Postgres via docker-compose:
# DATABASE_URL=postgresql+psycopg://health:health@localhost:5432/health
DATABASE_URL=sqlite:///./health.db

# Comma-separated origins allowed to call the API (the Next.js dashboard)
CORS_ORIGINS=http://localhost:3000

# "development" on your own machine. Set anything else (e.g. production) for a
# deployment: the API then refuses to start while SECRET_KEY or ADMIN_PASSWORD
# is still the value below. It refuses the same way whenever DATABASE_URL is
# not SQLite or CORS_ORIGINS names a host other than localhost.
ENVIRONMENT=development

# Auth. SECRET_KEY signs session tokens — set a long random value outside dev,
# e.g. python -c "import secrets; print(secrets.token_urlsafe(48))".
# The admin account below is created at first startup if no admin exists.
SECRET_KEY=dev-secret-change-me
ADMIN_EMAIL=admin@health.local
ADMIN_PASSWORD=admin12345
ADMIN_NAME=Administrator
