# Copy to .env and fill in. The app runs without an API key — LLM features
# (lab-report OCR, report phrasing) simply report "not configured".

# Anthropic API key for OCR extraction and report writing (optional)
ANTHROPIC_API_KEY=

# Database. SQLite needs no setup. For Postgres via docker-compose:
# DATABASE_URL=postgresql+psycopg://health:health@localhost:5432/health
DATABASE_URL=sqlite:///./health.db

# Comma-separated origins allowed to call the API (the Next.js dashboard)
CORS_ORIGINS=http://localhost:3000

# Auth. SECRET_KEY signs session tokens — set a long random value outside dev.
# The admin account below is created at first startup if no admin exists.
SECRET_KEY=dev-secret-change-me
ADMIN_EMAIL=admin@health.local
ADMIN_PASSWORD=admin12345
ADMIN_NAME=Administrator
