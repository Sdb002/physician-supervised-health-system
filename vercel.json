{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "dashboard": {
      "root": "dashboard/",
      "framework": "nextjs"
    },
    "api": {
      "root": "./",
      "framework": "fastapi",
      "entrypoint": "src.api.main:app",
      "functions": {
        "src/api/main.py": {
          "maxDuration": 300,
          "excludeFiles": "{dashboard/**,tests/*.py,tests/__pycache__/**,notebooks/**,thesis/**,scripts/**,docs/**,data/*/raw/**,data/*/snapshots/**,**/__pycache__/**,.venv/**,*.db,*.db-journal}"
        }
      }
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "dashboard" } }
  ]
}
